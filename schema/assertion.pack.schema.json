{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://record-schema.solomondao.org/schema/assertion.pack.schema.json",
  "title": "Record Schema assertion pack",
  "description": "A repository-owned declarative program for cross-document validation, deterministic reporting, and deterministic materialisation. Implementations execute only the closed vocabulary defined by this schema.",
  "type": "object",
  "required": [
    "schema",
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "record-schema-assertion-pack"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "default_source": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/language"
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/selectorDefinition"
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/report"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringOrArray": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "path": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "$ref": "#/$defs/stringOrArray"
        },
        "exclude": {
          "$ref": "#/$defs/stringOrArray"
        },
        "parse": {
          "enum": [
            "auto",
            "yaml",
            "json",
            "markdown",
            "text",
            "none"
          ]
        },
        "doc_types": {
          "$ref": "#/$defs/stringOrArray"
        },
        "schema_ids": {
          "$ref": "#/$defs/stringOrArray"
        },
        "series": {
          "$ref": "#/$defs/stringOrArray"
        }
      }
    },
    "selectorDefinition": {
      "oneOf": [
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/selector"
              }
            ]
          }
        }
      ]
    },
    "selectorReference": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/selector"
              }
            ]
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "unit_where": {},
        "where": {},
        "each": {
          "type": "string",
          "minLength": 1
        },
        "each_where": {},
        "scope_key": {
          "type": "string"
        },
        "with_tables": {
          "$ref": "#/$defs/stringArray"
        },
        "bind": {
          "type": "object"
        },
        "expand": {
          "type": "object"
        },
        "extract": {
          "$ref": "#/$defs/extract"
        },
        "lex": {
          "$ref": "#/$defs/lexTransform"
        },
        "post_where": {},
        "project": {
          "type": "object"
        }
      }
    },
    "extract": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "pattern"
          ],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string"
            },
            "from": {},
            "flags": {
              "type": "string"
            },
            "global": {
              "type": "boolean"
            },
            "group": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                }
              ]
            },
            "groups": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "project": {
              "type": "object"
            }
          }
        }
      ]
    },
    "lexTransform": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/language"
                }
              ]
            },
            "from": {},
            "kinds": {
              "$ref": "#/$defs/stringOrArray"
            },
            "roles": {
              "$ref": "#/$defs/stringOrArray"
            },
            "emit": {
              "enum": [
                "text",
                "object"
              ]
            }
          }
        }
      ]
    },
    "table": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "entries"
          ],
          "additionalProperties": false,
          "properties": {
            "entries": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "select": {
              "$ref": "#/$defs/selectorReference"
            },
            "source": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/source"
                }
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "unit_where": {},
            "where": {},
            "each": {
              "type": "string"
            },
            "each_where": {},
            "scope_key": {
              "type": "string"
            },
            "bind": {
              "type": "object"
            },
            "expand": {
              "type": "object"
            },
            "extract": {
              "$ref": "#/$defs/extract"
            },
            "lex": {
              "$ref": "#/$defs/lexTransform"
            },
            "post_where": {},
            "project": {
              "type": "object"
            },
            "with_tables": {
              "$ref": "#/$defs/stringArray"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "mode": {
              "enum": [
                "scalar",
                "list",
                "set",
                "count",
                "sum",
                "minimum",
                "maximum"
              ]
            },
            "on_duplicate": {
              "enum": [
                "first",
                "last",
                "error"
              ]
            }
          }
        }
      ]
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier_pattern": {
          "type": "string"
        },
        "number_pattern": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "multi_operators": {
          "$ref": "#/$defs/stringArray"
        },
        "single_operators": {
          "type": "string"
        },
        "punctuation": {
          "type": "string"
        },
        "line_comments": {
          "$ref": "#/$defs/stringArray"
        },
        "block_comments": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "string_quotes": {
          "type": "string"
        },
        "call_open": {
          "type": "string",
          "minLength": 1
        },
        "allow_empty": {
          "type": "boolean"
        },
        "member_operators": {
          "$ref": "#/$defs/stringArray"
        },
        "balanced_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "forbid_adjacent": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "select": {
          "$ref": "#/$defs/selectorReference"
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "unit_where": {},
        "where": {},
        "each": {
          "type": "string"
        },
        "each_where": {},
        "scope_key": {
          "type": "string"
        },
        "with_tables": {
          "$ref": "#/$defs/stringArray"
        },
        "bind": {
          "type": "object"
        },
        "expand": {
          "type": "object"
        },
        "extract": {
          "$ref": "#/$defs/extract"
        },
        "lex": {
          "$ref": "#/$defs/lexTransform"
        },
        "post_where": {},
        "project": {
          "type": "object"
        },
        "key": {
          "type": "string"
        },
        "value": {},
        "on_duplicate": {
          "enum": [
            "first",
            "last",
            "error"
          ]
        }
      }
    },
    "reachEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "select": {
          "$ref": "#/$defs/selectorReference"
        },
        "key": {},
        "from": {},
        "to": {},
        "value": {},
        "origin": {},
        "group": {},
        "origin_relation": {
          "enum": [
            "same",
            "different"
          ]
        },
        "group_relation": {
          "enum": [
            "same",
            "different"
          ]
        },
        "exclude_same_origin": {
          "type": "boolean"
        },
        "match": {
          "enum": [
            "exact",
            "word",
            "nearby"
          ]
        },
        "boundary": {
          "type": "string"
        },
        "window": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "type": "string"
        }
      }
    },
    "reachPropagation": {
      "type": "object",
      "required": [
        "declarations",
        "activations"
      ],
      "additionalProperties": false,
      "properties": {
        "declarations": {
          "$ref": "#/$defs/selectorReference"
        },
        "activations": {
          "$ref": "#/$defs/selectorReference"
        },
        "name": {},
        "values": {},
        "origin": {},
        "activation_origin": {},
        "activation_text": {},
        "origin_relation": {
          "enum": [
            "same",
            "different"
          ]
        },
        "exclude_same_origin": {
          "type": "boolean"
        },
        "match": {
          "enum": [
            "exact",
            "word",
            "nearby"
          ]
        },
        "boundary": {
          "type": "string"
        },
        "window": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "type": "string"
        }
      }
    },
    "materializer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "rewrite",
            "yaml_inline_mapping_field",
            "reach_baseline"
          ]
        },
        "file": {
          "type": "string"
        },
        "mapping_key": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "value": {},
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reachMaterializerSection"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "yaml_inline_mapping_field"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "mapping_key",
              "field",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "reach_baseline"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "required": [
              "file",
              "sections"
            ]
          }
        }
      ]
    },
    "reachMaterializerSection": {
      "type": "object",
      "required": [
        "rule",
        "field",
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "entry": {
          "type": "object"
        },
        "category_field": {
          "type": "string"
        },
        "default_category": {},
        "sort_by": {
          "$ref": "#/$defs/stringOrArray"
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reportSection"
          }
        }
      }
    },
    "reportSection": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "table",
            "reach_summary",
            "reach_catalogue",
            "text"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "select": {
          "$ref": "#/$defs/selectorReference"
        },
        "group": {
          "type": "string"
        },
        "sort": {
          "oneOf": [
            {
              "$ref": "#/$defs/reportSort"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reportSort"
              }
            }
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportColumn"
          }
        },
        "computed": {
          "type": "object"
        },
        "detail_prefix": {
          "type": "string"
        },
        "detail_include": {},
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportColumn"
          }
        },
        "rules": {
          "$ref": "#/$defs/stringArray"
        },
        "rule": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "realised_tiers": {
          "$ref": "#/$defs/stringArray"
        },
        "show_tiers": {
          "$ref": "#/$defs/stringArray"
        },
        "lines": {
          "$ref": "#/$defs/stringArray"
        },
        "category_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "categories"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "categories": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        },
        "order": {
          "enum": [
            "label",
            "source"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "select",
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reach_summary"
              }
            }
          },
          "then": {
            "required": [
              "rules"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reach_catalogue"
              }
            }
          },
          "then": {
            "required": [
              "rule"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "reportSort": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string"
            },
            "direction": {
              "enum": [
                "ascending",
                "descending"
              ]
            }
          }
        }
      ]
    },
    "reportColumn": {
      "type": "object",
      "required": [
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "value": {},
        "aggregate": {
          "enum": [
            "first",
            "last",
            "count",
            "sum",
            "min",
            "max",
            "any",
            "all",
            "list",
            "unique_list",
            "join"
          ]
        },
        "count_all": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "separator": {
          "type": "string"
        },
        "order_by": {},
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "align": {
          "enum": [
            "left",
            "right"
          ]
        },
        "gap_before": {
          "type": "integer",
          "minimum": 0
        },
        "hidden": {
          "type": "boolean"
        },
        "present_if": {
          "type": "string"
        },
        "null": {}
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(?:/[A-Z][A-Z0-9_]*)?$"
        },
        "kind": {
          "enum": [
            "forbid",
            "require",
            "pattern",
            "unique",
            "consistent",
            "resolve",
            "agree",
            "derive",
            "count",
            "reach",
            "cycle",
            "decode",
            "lex",
            "path",
            "format"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "advisory"
          ]
        },
        "severity_by_mode": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "error",
              "warning",
              "advisory"
            ]
          }
        },
        "modes": {
          "$ref": "#/$defs/stringOrArray"
        },
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        },
        "select": {
          "$ref": "#/$defs/selectorReference"
        },
        "scope": {
          "$ref": "#/$defs/selectorReference"
        },
        "with_tables": {
          "$ref": "#/$defs/stringArray"
        },
        "bind": {
          "type": "object"
        },
        "when": {
          "type": "string"
        },
        "must": {},
        "match": {
          "type": "string"
        },
        "not_match": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "within": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "value": {},
        "uses": {
          "$ref": "#/$defs/selectorReference"
        },
        "defines": {
          "$ref": "#/$defs/selectorReference"
        },
        "use_key": {
          "type": "string"
        },
        "define_key": {
          "type": "string"
        },
        "use_scope": {
          "type": "string"
        },
        "define_scope": {
          "type": "string"
        },
        "dedupe_uses": {
          "type": "boolean"
