{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomondao.org/record-schema/license.registry.schema.json",
  "title": "Canonical License Registry",
  "description": "Manifest for canonical custom license texts and their license-body-v1 SHA-256 identities.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "canonical_repository",
    "checksum_surface",
    "licenses"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema": {
      "type": "string",
      "const": "record-schema-license-registry"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "canonical_repository": {
      "type": "string",
      "const": "https://github.com/SolomonDAOrg/licenses"
    },
    "checksum_surface": {
      "type": "string",
      "const": "license-body-v1"
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spdx_license_identifier",
          "title",
          "version",
          "effective_date",
          "path",
          "canonical_url",
          "checksum_sha256",
          "checksum_surface"
        ],
        "properties": {
          "spdx_license_identifier": {
            "type": "string",
            "pattern": "^LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          },
          "path": {
            "type": "string",
            "pattern": "^LICENSES/LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
          },
          "canonical_url": {
            "type": "string",
            "pattern": "^https://github\\.com/SolomonDAOrg/licenses/blob/main/LICENSES/LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checksum_surface": {
            "type": "string",
            "const": "license-body-v1"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
