{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomondao.org/record-schema/schema/schema_upstream.schema.json",
  "title": "Record Schema Upstream Declaration",
  "type": "object",
  "required": [
    "schema",
    "schema_version"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "record-schema-upstream"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "record_schema": {
      "type": "object",
      "properties": {
        "upstreams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "licenseRef": {
                "type": "string",
                "pattern": "^LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
              },
              "licenseCanonicalUrl": {
                "type": "string",
                "pattern": "^https://github\\.com/SolomonDAOrg/licenses/blob/main/LICENSES/LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
              },
              "licenseChecksumSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "licenseChecksumSurface": {
                "type": "string",
                "const": "license-body-v1"
              },
              "licenseFile": {
                "type": "string",
                "minLength": 1
              }
            },
            "dependentRequired": {
              "license": [
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseRef": [
                "license",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseCanonicalUrl": [
                "license",
                "licenseRef",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseChecksumSha256": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSurface"
              ],
              "licenseChecksumSurface": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256"
              ],
              "licenseFile": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ]
            },
            "additionalProperties": true
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "licenseRef": {
                "type": "string",
                "pattern": "^LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
              },
              "licenseCanonicalUrl": {
                "type": "string",
                "pattern": "^https://github\\.com/SolomonDAOrg/licenses/blob/main/LICENSES/LicenseRef-[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
              },
              "licenseChecksumSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "licenseChecksumSurface": {
                "type": "string",
                "const": "license-body-v1"
              },
              "licenseFile": {
                "type": "string",
                "minLength": 1
              }
            },
            "dependentRequired": {
              "license": [
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseRef": [
                "license",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseCanonicalUrl": [
                "license",
                "licenseRef",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ],
              "licenseChecksumSha256": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSurface"
              ],
              "licenseChecksumSurface": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256"
              ],
              "licenseFile": [
                "license",
                "licenseRef",
                "licenseCanonicalUrl",
                "licenseChecksumSha256",
                "licenseChecksumSurface"
              ]
            },
            "additionalProperties": true
          }
        },
        "profile_path": {
          "type": "string",
          "minLength": 1
        },
        "profile_hint": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "registry_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "registry": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "formatting_packs": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "render_packs": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "packs": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ],
          "description": "Alias for formatting_packs."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}