{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomondao.org/record-schema/deployment-release/deployment-batch-manifest.schema.json",
  "title": "Deployment Batch Artifact Manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "batch_id",
    "record_id",
    "sequence",
    "batch_kind",
    "network",
    "cluster",
    "program_id",
    "expected_deployer_public_key",
    "source_release",
    "source_revision",
    "previous_batch_manifest_sha256",
    "previous_batch_attestation_sha256",
    "plan_sha256",
    "plan_file_sha256",
    "final_execution_evidence_source_path",
    "final_execution_evidence_sha256",
    "artifact_root_sha256",
    "artifact_count",
    "finalized_at_utc",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "deployment-release-batch-manifest"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^DEP-\\d{5}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^DEP-\\d{5}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "batch_kind": {
      "type": "string",
      "enum": [
        "initial_deployment",
        "program_upgrade"
      ]
    },
    "network": {
      "type": "string",
      "minLength": 1
    },
    "cluster": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "expected_deployer_public_key": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "source_release": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "previous_batch_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_batch_attestation_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1
    },
    "finalized_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "source_path",
          "artifact_type",
          "stage",
          "media_type",
          "sha256",
          "size_bytes",
          "checksum_target_source_path",
          "checksum_claim_valid"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "checksum_target_source_path": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "checksum_claim_valid": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "final_execution_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_execution_evidence_source_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*$"
    }
  },
  "additionalProperties": false
}
