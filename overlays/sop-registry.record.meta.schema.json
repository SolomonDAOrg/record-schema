{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solomondao.org/record-schema/overlays/sop-registry.record.meta.schema.json",
  "title": "SOP Registry META Overlay",
  "type": "object",
  "description": "Overlay schema for sop-registry records to support Operational Pack pinning (dao-proposals).",
  "allOf": [
    {
      "$ref": "https://solomondao.org/record-schema/record.meta.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object",
          "properties": {
            "sop_registry": { "$ref": "#/$defs/sopRegistryExtension" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "if": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "object",
            "required": ["phase"],
            "properties": {
              "phase": { "enum": ["ratified", "adopted", "effective", "current"] }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "extensions": {
            "type": "object",
            "required": ["sop_registry"],
            "properties": {
              "sop_registry": {
                "type": "object",
                "required": ["operational_pack"],
                "properties": {
                  "operational_pack": {
                    "type": "object",
                    "required": ["record_id"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sopRegistryExtension": {
      "type": "object",
      "properties": {
        "operational_pack": { "$ref": "#/$defs/operationalPackPin" }
      },
      "additionalProperties": true
    },
    "operationalPackPin": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^DP-\\d{5}$",
          "description": "Operational Pack record id in dao-proposals (DP-xxxxx)."
        },
        "vote_reference": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "passed_tag": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "passed_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "adopted_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}