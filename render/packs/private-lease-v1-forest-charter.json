{
  "schema": "record-schema-render-pack",
  "schema_version": 1,
  "pack_id": "private-lease-render-v1-forest-charter",
  "description": "Private lease render pack with forest charter styling, pale vellum paper, and restrained old-world serif typography.",
  "imports": [
    "render/packs/base-v1.json"
  ],
  "packet_config": {
    "default_entity_name": "PRIVATE RESIDENTIAL LEASE",
    "default_document_title": "LEASE PACKET",
    "header_text": "",
    "series_prefix": "^(LEA-\\d+_)?",
    "header_title_format": "plain",
    "section_page_break": "always",
    "path_to_title": {
      "Lease_Agreement": "LEASE AGREEMENT",
      "Residential_Lease_Agreement": "RESIDENTIAL LEASE AGREEMENT",
      "Residential_Space_Lease_Agreement": "RESIDENTIAL SPACE LEASE AGREEMENT",
      "Index": "INDEX"
    },
    "name_patterns": [
      "Lease_Agreement",
      "Residential_Lease_Agreement",
      "Residential_Space_Lease_Agreement",
      "Agreement",
      "index"
    ],
    "entity_extraction": {
      "fields": [
        "entity_name",
        "title"
      ]
    },
    "cover_config": {
      "suppress_header": true,
      "suppress_footer": true,
      "suppress_page_numbering": true,
      "reserve_header_footer_space": false,
      "draft_watermark": {
        "enabled": false,
        "text": "",
        "gray": 0.9,
        "angle_deg": 35,
        "font_size": 84
      },
      "cover_layout": {
        "description": "Deep green charter palette with soft vellum paper. The most stately and conservative of the three.",
        "palette": {
          "accent": "#1F4A3A",
          "title": "#10261F",
          "muted": "#5E6F68",
          "danger": "#8B2E24",
          "paper": "#F8FBF8",
          "note_fill": "#EEF5F1",
          "note_border": "#C9D8D0",
          "badge_text": "#F7FBF8",
          "badge_fill": "#1F4A3A",
          "badge_rule": "#D7E3DC"
        },
        "eyebrow": {
          "enabled": true,
          "text": "PRIVATE LEASE / EXECUTION PACKET",
          "align": "center",
          "font_size": 10.25,
          "color": "#F7FBF8",
          "after_spacer": 16,
          "letter_spacing": 1.2,
          "background_color": "#1F4A3A",
          "border_color": "#D7E3DC",
          "padding_x": 12,
          "padding_y": 6,
          "top_spacer": 18
        },
        "title_block": {
          "top_spacer": 88,
          "align": "center",
          "title_font_size": 29,
          "subtitle_font_size": 12.25,
          "entity_font_size": 17.5,
          "include_conjunction_line": false,
          "after_title_spacer": 8,
          "after_subtitle_spacer": 11,
          "after_entity_spacer": 16,
          "title_color": "#10261F",
          "subtitle_color": "#5E6F68",
          "entity_color": "#1F4A3A"
        },
        "rule": {
          "enabled": true,
          "start_frac": 0.21,
          "end_frac": 0.79,
          "line_width": 0.8,
          "color": "#90A89C",
          "after_spacer": 18
        },
        "metadata_block": {
          "layout": "columns",
          "align": "left",
          "label_align": "left",
          "column_gap": 12,
          "font_size": 10,
          "line_spacer": 6,
          "label_value_separator": ": ",
          "separator": ": ",
          "start_frac": 0.18,
          "end_frac": 0.82,
          "fields": [
            {
              "key": "document_id",
              "label": "Document ID"
            },
            {
              "key": "version",
              "label": "Version"
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "effective_date",
              "label": "Effective Date"
            },
            {
              "key": "confidentiality",
              "label": "Confidentiality"
            }
          ],
          "label_color": "#5E6F68",
          "value_color": "#10261F",
          "background_color": "#EEF5F1",
          "border_color": "#C9D8D0",
          "padding": 10
        },
        "footer_note": {
          "enabled": false,
          "align": "center",
          "font_size": 9.25,
          "color": "#60756A",
          "top_spacer": 22,
          "text": "Execution copy for a private present lease of defined space. Use only with true particulars and matching address records."
        },
        "page_background": {
          "color": "#F8FBF8"
        },
        "page_frame": {
          "enabled": true,
          "inset": 18,
          "line_width": 0.9,
          "color": "#C9D8D0"
        },
        "content_margins": {
          "top": 0,
          "right": 0,
          "bottom": 0,
          "left": 0
        }
      },
      "font_roles": {
        "eyebrow": "cover_eyebrow",
        "title": "cover_title",
        "subtitle": "cover_subtitle",
        "entity": "cover_entity",
        "metadata_label": "cover_meta_label",
        "metadata_value": "cover_meta_value",
        "footer_note": "cover_footer"
      }
    },
    "packet_variants": {
      "default": {
        "include_cover": true,
        "include_toc": true
      },
      "short_lease": {
        "include_cover": true,
        "include_toc": false
      },
      "notice": {
        "include_cover": false,
        "include_toc": false,
        "signing_page": false
      }
    }
  },
  "document_policies": {
    "defaults": {
      "output_encoding": "utf-8",
      "output_newlines": "lf",
      "horizontal_rule_behavior": "page-break"
    },
    "targets": {
      "pdf": {
        "format": "pdf",
        "page_size": "letter",
        "orientation": "portrait",
        "margins": {
          "top": 72,
          "bottom": 72,
          "left": 72,
          "right": 72,
          "unit": "pt"
        },
        "fonts": {
          "regular": "LeaseBody-Regular",
          "bold": "LeaseBody-Bold",
          "italic": "LeaseBody-Italic",
          "bold_italic": "LeaseBody-BoldItalic",
          "monospace": "Courier"
        },
        "base_font_size": 10.0,
        "title_font_size": 18,
        "heading_scales": {
          "h1": 1.7,
          "h2": 1.45,
          "h3": 1.25,
          "h4": 1.1
        },
        "line_spacing": 1.5,
        "paragraph_spacing_factor": 0.52,
        "list_indent_per_level": 20,
        "code_block_indent": 36,
        "horizontal_rule": {
          "behavior": "page-break"
        },
        "inline_formatting": {
          "enabled": true,
          "underline_offset_factor": 0.15,
          "underline_thickness_small": 0.5,
          "underline_thickness_large": 0.75,
          "underline_size_threshold": 12
        },
        "toc": {
          "title_font_size": 15.5,
          "level_styles": {
            "1": {
              "font_size_scale": 1.05,
              "bold": true,
              "indent": 0,
              "spacing_after": 1.15,
              "spacing_before": 1.2
            },
            "2": {
              "font_size_scale": 0.92,
              "bold": true,
              "indent": 24,
              "spacing_after": 1.2
            }
          }
        },
        "table": {
          "font_size_scale": 0.95,
          "min_font_size": 6,
          "max_font_size": 10,
          "auto_shrink": true,
          "cell_padding": {
            "x": 4,
            "y": 3
          },
          "border_width": 0.5,
          "border_color": "#CBD8D1",
          "header": {
            "background_color": "#EAF3EE",
            "text_color": "#10261F",
            "cell_padding": {
              "x": 4,
              "y": 3
            }
          },
          "zebra": {
            "enabled": true,
            "odd_background": "#FFFFFF",
            "even_background": "#F6FAF7"
          },
          "line_height": 1.2,
          "bleed_in": 0.2,
          "bleed_if_columns_gt": 8,
          "min_page_edge_inset_in": 0.25
        },
        "embedded_fonts": {
          "enabled": true,
          "resolve_relative_to": "pack",
          "register_before_layout": true,
          "encoding": "WinAnsiEncoding",
          "roles": {
            "cover_title": "LeaseDisplay-Regular",
            "cover_eyebrow": "LeaseDisplay-Bold",
            "cover_subtitle": "LeaseBody-Italic",
            "cover_entity": "LeaseAccent-Bold",
            "cover_meta_label": "LeaseAccent-Regular",
            "cover_meta_value": "LeaseBody-Regular",
            "cover_footer": "LeaseBody-Italic",
            "body": "LeaseBody-Regular",
            "body_regular": "LeaseBody-Regular",
            "body_bold": "LeaseBody-Bold",
            "body_italic": "LeaseBody-Italic",
            "body_bold_italic": "LeaseBody-BoldItalic",
            "heading_display": "LeaseAccent-Bold",
            "heading_display_regular": "LeaseAccent-Regular",
            "heading_display_bold": "LeaseAccent-Bold",
            "heading_display_italic": "LeaseAccent-Italic",
            "heading_display_bold_italic": "LeaseAccent-BoldItalic",
            "toc_title": "LeaseDisplay-Regular",
            "toc_title_bold": "LeaseDisplay-Bold",
            "toc_entry": "LeaseAccent-Regular",
            "toc_entry_bold": "LeaseAccent-Bold",
            "table_heading": "LeaseAccent-Bold",
            "table_heading_bold": "LeaseAccent-Bold",
            "table_body": "LeaseBody-Regular",
            "table_body_regular": "LeaseBody-Regular",
            "table_body_bold": "LeaseBody-Bold",
            "table_caption": "LeaseAccent-Bold",
            "table_caption_bold": "LeaseAccent-Bold",
            "definition_term": "LeaseAccent-Bold",
            "definition_term_bold": "LeaseAccent-Bold",
            "notice_title": "LeaseAccent-Bold",
            "notice_title_bold": "LeaseAccent-Bold",
            "signature_title": "LeaseAccent-Bold",
            "signature_title_bold": "LeaseAccent-Bold",
            "signature_label": "LeaseBody-Regular",
            "signature_label_regular": "LeaseBody-Regular",
            "signature_value": "LeaseBody-Regular",
            "signature_value_regular": "LeaseBody-Regular",
            "code": "Courier",
            "code_monospace": "Courier"
          },
          "families": {
            "Lora": {
              "faces": {
                "regular": {
                  "postscript_name": "LeaseBody-Regular",
                  "google_font": {
                    "family": "Lora",
                    "weight": 400,
                    "style": "normal"
                  },
                  "fallback": "Times-Roman"
                },
                "bold": {
                  "postscript_name": "LeaseBody-Bold",
                  "google_font": {
                    "family": "Lora",
                    "weight": 700,
                    "style": "normal"
                  },
                  "fallback": "Times-Bold"
                },
                "italic": {
                  "postscript_name": "LeaseBody-Italic",
                  "google_font": {
                    "family": "Lora",
                    "weight": 400,
                    "style": "italic"
                  },
                  "fallback": "Times-Italic"
                },
                "bold_italic": {
                  "postscript_name": "LeaseBody-BoldItalic",
                  "google_font": {
                    "family": "Lora",
                    "weight": 700,
                    "style": "italic"
                  },
                  "fallback": "Times-BoldItalic"
                }
              }
            },
            "CormorantGaramond": {
              "faces": {
                "regular": {
                  "postscript_name": "LeaseAccent-Regular",
                  "google_font": {
                    "family": "Cormorant Garamond",
                    "weight": 500,
                    "style": "normal"
                  },
                  "fallback": "LeaseBody-Regular"
                },
                "bold": {
                  "postscript_name": "LeaseAccent-Bold",
                  "google_font": {
                    "family": "Cormorant Garamond",
                    "weight": 700,
                    "style": "normal"
                  },
                  "fallback": "LeaseBody-Bold"
                },
                "italic": {
                  "postscript_name": "LeaseAccent-Italic",
                  "google_font": {
                    "family": "Cormorant Garamond",
                    "weight": 500,
                    "style": "italic"
                  },
                  "fallback": "LeaseBody-Italic"
                },
                "bold_italic": {
                  "postscript_name": "LeaseAccent-BoldItalic",
                  "google_font": {
                    "family": "Cormorant Garamond",
                    "weight": 700,
                    "style": "italic"
                  },
                  "fallback": "Times-BoldItalic"
                }
              }
            },
            "CormorantSC": {
              "faces": {
                "regular": {
                  "postscript_name": "LeaseDisplay-Regular",
                  "google_font": {
                    "family": "Cormorant SC",
                    "weight": 500,
                    "style": "normal"
                  },
                  "fallback": "LeaseAccent-Regular"
                },
                "bold": {
                  "postscript_name": "LeaseDisplay-Bold",
                  "google_font": {
                    "family": "Cormorant SC",
                    "weight": 700,
                    "style": "normal"
                  },
                  "fallback": "LeaseAccent-Bold"
                }
              }
            }
          },
          "fallbacks": {
            "regular": "Times-Roman",
            "bold": "Times-Bold",
            "italic": "Times-Italic",
            "boldItalic": "Times-BoldItalic",
            "monospace": "Courier"
          }
        },
        "font_role_defaults": {
          "body": "body",
          "heading_1": "heading_display",
          "heading_2": "heading_display",
          "heading_3": "heading_display",
          "heading_4": "heading_display",
          "heading_5": "heading_display",
          "heading_6": "heading_display",
          "toc_title": "toc_title",
          "toc_entry": "toc_entry",
          "table_header": "table_heading",
          "table_body": "table_body",
          "table_caption": "table_caption",
          "definition_term": "definition_term",
          "notice_title": "notice_title",
          "signature_title": "signature_title",
          "signature_label": "signature_label",
          "signature_value": "signature_value",
          "code": "code"
        }
      }
    },
    "render_profiles": {
      "lease-standard-v1": {
        "description": "Standard private lease PDF rendering using the forest charter font contract",
        "target": "pdf",
        "overrides": {
          "break_mode": "always"
        }
      },
      "lease-packet-v1": {
        "description": "Private lease packet with forest charter cover styling and TOC",
        "target": "pdf",
        "extends": "lease-standard-v1",
        "overrides": {
          "base_font_size": 10,
          "line_spacing": 1.48,
          "horizontal_rule": {
            "behavior": "page-break"
          },
          "leading_section": {
            "mode": "centered-title-block",
            "max_nodes": 8,
            "stop_at_metadata": true,
            "stop_at_horizontal_rule": true
          }
        }
      }
    },
    "rulesets": [
      {
        "id": "lease-packet-v1",
        "selectors": {
          "doc_types": [
            "PACKET",
            "PKT"
          ],
          "extensions": [
            "pdf"
          ]
        },
        "render": {
          "target": "pdf",
          "render_profile_id": "lease-packet-v1"
        }
      },
      {
        "id": "lease-agreement-v1",
        "selectors": {
          "doc_types": [
            "SA",
            "LEASE",
            "AGR"
          ],
          "extensions": [
            "md"
          ]
        },
        "render": {
          "target": "pdf",
          "render_profile_id": "lease-standard-v1"
        }
      },
      {
        "id": "lease-index-v1",
        "selectors": {
          "doc_types": [
            "IND"
          ],
          "extensions": [
            "md"
          ]
        },
        "render": {
          "target": "pdf",
          "render_profile_id": "lease-standard-v1"
        }
      }
    ],
    "spacing_policy": {
      "pair_rules": [
        {
          "prev": "heading",
          "curr": "paragraph",
          "before_em": 0.42
        },
        {
          "prev": "paragraph",
          "curr": "heading",
          "before_em": 1.18
        },
        {
          "prev": "heading",
          "curr": "heading",
          "before_em": 0.56
        },
        {
          "prev": "list",
          "curr": "heading",
          "before_em": 1.1
        },
        {
          "prev": "paragraph",
          "curr": "paragraph",
          "before_em": 0.62
        },
        {
          "prev": "paragraph",
          "curr": "list",
          "before_em": 0.38
        },
        {
          "prev": "list",
          "curr": "paragraph",
          "before_em": 0.62
        },
        {
          "prev": "table",
          "curr": "paragraph",
          "before_em": 0.72
        }
      ],
      "defaults": {
        "heading": {
          "before_em": 0.95,
          "after_em": 0.32
        },
        "paragraph": {
          "before_em": 0.42,
          "after_em": 0.42
        },
        "list": {
          "before_em": 0.38,
          "after_em": 0.38
        },
        "code-block": {
          "before_em": 0.65,
          "after_em": 0.65
        },
        "table": {
          "before_em": 0.68,
          "after_em": 0.68
        }
      }
    }
  }
}