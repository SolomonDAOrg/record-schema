    "spacing_policy": {
      "pair_rules": [
        {
          "prev": "heading",
          "curr": "paragraph",
          "before_em": 0.5
        },
        {
          "prev": "paragraph",
          "curr": "heading",
          "before_em": 1.5
        },
        {
          "prev": "heading",
          "curr": "heading",
          "before_em": 0.75
        },
        {
          "prev": "list",
          "curr": "heading",
          "before_em": 1.5
        },
        {
          "prev": "paragraph",
          "curr": "paragraph",
          "before_em": 0.75
        },
        {
          "prev": "paragraph",
          "curr": "list",
          "before_em": 0.5
        },
        {
          "prev": "list",
          "curr": "paragraph",
          "before_em": 0.75
        },
        {
          "prev": "article",
          "curr": "paragraph",
          "before_em": 0.75
        },
        {
          "prev": "section",
          "curr": "paragraph",
          "before_em": 0.5
        }
      ],
      "defaults": {
        "heading": {
          "before_em": 1.2,
          "after_em": 0.4
        },
        "paragraph": {
          "before_em": 0.5,
