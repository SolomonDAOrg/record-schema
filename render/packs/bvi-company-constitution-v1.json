        "overrides": {
          "horizontal_rule": {
            "behavior": "rule",
            "width_factor": 1,
            "thickness": 1,
            "color": "#0F3D5E",
            "spacing_before": 10,
            "spacing_after": 14
          },
          "leading_section": {
            "mode": "centered-title-block",
            "max_nodes": 8,
            "stop_at_metadata": true,
            "stop_at_horizontal_rule": true
          }
        }
      },
      "entity-legal-part-only-v1": {
