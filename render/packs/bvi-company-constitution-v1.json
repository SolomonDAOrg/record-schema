        "target": "pdf",
        "extends": "entity-legal-standard-v1",
        "overrides": {
          "break_mode": "part-only"
        }
      },
      "bvi-company-constitution-v1": {
        "description": "BVI Memorandum and Articles of Association packet: classic law-office constitution typography, cover, TOC, A4 page, and conservative margins.",
        "target": "pdf",
        "extends": "entity-filing-packet-v1",
        "overrides": {
          "base_font_size": 11,
          "line_spacing": 1.35,
          "margins": {
            "top": 72,
            "bottom": 72,
            "left": 78,
            "right": 72,
            "unit": "pt"
          },
          "horizontal_rule": {
            "behavior": "page-break"
          },
          "leading_section": {
            "mode": "centered-title-block",
            "max_nodes": 8,
            "stop_at_metadata": true,
            "stop_at_horizontal_rule": true
          }
        }
      },
      "bvi-company-register-v1": {
        "description": "BVI governance register/index rendering with the same font system but lighter front matter.",
        "target": "pdf",
        "extends": "entity-legal-standard-v1",
        "overrides": {
          "base_font_size": 10,
          "line_spacing": 1.35,
          "horizontal_rule": {
            "behavior": "rule",
            "width_factor": 1,
            "thickness": 0.75,
            "color": "#B49A67",
            "spacing_before": 8,
            "spacing_after": 12
          }
        }
      }
    },
