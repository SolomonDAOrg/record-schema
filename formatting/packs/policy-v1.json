{
  "schema": "record-schema-formatting-pack",
  "schema_version": 1,
  "pack_id": "policy-v1",
  "description": "Policy registry document policies for internal policy and procedure records. Imports base-v1.",
  "imports": [
    "formatting/packs/base-v1.json"
  ],
  "document_policies": {
    "style_profiles": {
      "policy-v1": {
        "description": "Internal policies. Structured, clear, control-oriented, and slightly less dense than charter-style legal instruments.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for control labels, defined terms, and short emphasis."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "policy-sop-v1": {
        "description": "Operational procedures supporting policies. Step-focused, action-oriented, and suitable for checklists and workflow notes.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold may be used for steps, control checkpoints, and escalation labels."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "policy-index-v1": {
        "description": "Indexes and navigational documents for policy packs.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for labels and section cues."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "policy-note-v1": {
        "description": "Internal notes, guidance, and supporting memos associated with policy records.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold allowed for labels and short emphasis."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      }
    },
    "rulesets": [
      {
        "id": "root-license-v1",
        "severity": "error",
        "selectors": {
          "paths_glob": [
            "LICENSE"
          ],
          "is_root_file": true
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64",
              "legal_citations"
            ]
          },
          "language_locale": "en-US",
          "dialect_pack": "en-US-basic-v1",
          "formatting_profile": "canonical-ascii",
          "header_shape_id": "license-header-v1",
          "footer_shape_id": "license-footer-v1",
          "body_shape_id": "license-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
              "SPDX-LicenseIdentifier",
              "Document-Type",
              "Title",
              "Version",
              "Effective-Date",
              "Canonical-URL",
              "Checksum-SHA256",
              "Checksum-Surface"
          ],
          "style_profile_id": "license-v1",
          "header_template_path": "formatting/templates/root/LICENSE-header-v1.txt",
          "footer_template_path": "formatting/templates/root/LICENSE-footer-v1.txt"
        }
      },
      {
        "id": "license-documents-v1",
        "severity": "error",
        "selectors": {
          "doc_types": [
            "LIC"
          ],
          "paths_glob": [
            "**/LICENSE",
            "**/LICENSE-*.md",
            "**/*_LIC-*.md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64",
              "legal_citations"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "header_shape_id": "license-header-v1",
          "footer_shape_id": "license-footer-v1",
          "body_shape_id": "license-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "style_profile_id": "license-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "SPDX-LicenseIdentifier",
            "Document-Type",
            "Title",
            "Version",
            "Effective-Date",
            "Canonical-URL",
            "Checksum-SHA256",
            "Checksum-Surface"
          ]
        }
      },
      {
        "id": "policy-v1",
        "severity": "warn",
        "selectors": {
          "doc_types": [
            "POL"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "policy-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title",
            "Effective-Date"
          ],
          "metadata_optional_fields": [
            "Version",
            "Adopted-Date",
            "Review-Date",
            "Confidentiality",
            "SPDX-LicenseIdentifier"
          ]
        }
      },
      {
        "id": "policy-sop-v1",
        "severity": "warn",
        "selectors": {
          "doc_types": [
            "SOP"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "policy-sop-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title",
            "Effective-Date"
          ],
          "metadata_optional_fields": [
            "Version",
            "Adopted-Date",
            "Review-Date",
            "Confidentiality",
            "SPDX-LicenseIdentifier"
          ]
        }
      },
      {
        "id": "policy-guidance-v1",
        "severity": "info",
        "selectors": {
          "doc_types": [
            "DOC",
            "GUIDE",
            "FAQ",
            "NOTE"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "policy-note-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title"
          ],
          "metadata_optional_fields": [
            "Version",
            "Created-At",
            "Effective-Date",
            "Confidentiality",
            "SPDX-LicenseIdentifier"
          ]
        }
      },
      {
        "id": "policy-index-v1",
        "severity": "warn",
        "selectors": {
          "doc_types": [
            "IND"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "policy-index-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title",
            "Created-At"
          ],
          "metadata_optional_fields": [
            "Version",
            "Effective-Date",
            "Confidentiality"
          ]
        }
      },
      {
        "id": "policy-register-log-v1",
        "severity": "info",
        "selectors": {
          "doc_types": [
            "REG",
            "LOG",
            "FRM",
            "CHK"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "policy-sop-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title"
          ],
          "metadata_optional_fields": [
            "Version",
            "Created-At",
            "Effective-Date",
            "Confidentiality"
          ]
        }
      }
    ],
    "templates": {
      "policy-metadata-block-v1": {
        "description": "Template for policy document metadata block",
        "content": [
          "",
          "----------------------------BEGIN DOCUMENT METADATA-----------------------------",
          "Document-Type: POLICY",
          "Record-ID: ${record_id}",
          "Title: ${title}",
          "Version: ${version}",
          "Effective-Date: ${effective_date}",
          "Review-Date: ${review_date}",
          "Confidentiality: ${confidentiality}",
          "-----------------------------END DOCUMENT METADATA------------------------------"
        ]
      },
      "procedure-metadata-block-v1": {
        "description": "Template for policy procedure document metadata block",
        "content": [
          "",
          "----------------------------BEGIN DOCUMENT METADATA-----------------------------",
          "Document-Type: PROCEDURE",
          "Record-ID: ${record_id}",
          "Title: ${title}",
          "Version: ${version}",
          "Effective-Date: ${effective_date}",
          "Review-Date: ${review_date}",
          "Confidentiality: ${confidentiality}",
          "-----------------------------END DOCUMENT METADATA------------------------------"
        ]
      }
    },
    "precedence_notes": "Defaults < line_width_profiles (glob) < rulesets. POL and SOP documents use dedicated policy styles with required metadata and markdown envelopes."
  }
}
