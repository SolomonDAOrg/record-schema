{
  "schema": "record-schema-formatting-pack",
  "schema_version": 1,
  "pack_id": "deployment-release",
  "description": "Canonical formatting for deployment and release evidence reports.",
  "imports": [
    "formatting/packs/base-v1.json"
  ],
  "document_policies": {
    "defaults": {
      "language_locale": "en-GB",
      "line_width": {
        "max": 110,
        "ignore_blocks": [
          "code",
          "tables",
          "urls",
          "base58",
          "base64"
        ]
      },
      "encoding": "utf-8-no-bom",
      "newlines": "lf",
      "trailing_whitespace": "forbid"
    },
    "rulesets": [
      {
        "id": "deployment-report-markdown",
        "selectors": {
          "doc_types": [
            "DOC",
            "IND",
            "LOG"
          ],
          "extensions": [
            "md"
          ]
        },
        "enforce": {
          "formatting_profile": "baseline",
          "line_width": {
            "max": 110,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64"
            ]
          }
        }
      }
    ]
  }
}
