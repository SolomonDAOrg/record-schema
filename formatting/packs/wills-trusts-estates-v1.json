{
  "schema": "record-schema-formatting-pack",
  "schema_version": 1,
  "pack_id": "wills-trusts-estates-v1",
  "description": "Document policies for private wills, trusts and estates records. Imports template-agreements-v1 and applies estate-planning source rules for WTE series records.",
  "imports": [
    "formatting/packs/template-agreements-v1.json"
  ],
  "document_policies": {
    "rulesets": [
      {
        "id": "wte-testamentary-source-v1",
        "severity": "warn",
        "selectors": {
          "doc_types": [
            "WIL",
            "TRU",
            "COD",
            "POA",
            "ADV"
          ],
          "extensions": [
            "md"
          ],
          "paths_glob": [
            "**/*_WIL-*.md",
            "**/*_TRU-*.md",
            "**/*_COD-*.md",
            "**/*_POA-*.md",
            "**/*_ADV-*.md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "legal_citations"
            ]
          },
          "language_locale": "en-AU",
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "legal-master-agreement-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title",
            "Effective-Date"
          ],
          "metadata_optional_fields": [
            "Version",
            "Status",
            "Confidentiality",
            "Governing-Law"
          ]
        }
      },
      {
        "id": "wte-index-source-v1",
        "severity": "warn",
        "selectors": {
          "doc_types": [
            "IND"
          ],
          "extensions": [
            "md"
          ],
          "paths_glob": [
            "**/*_IND-*.md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls"
            ]
          },
          "language_locale": "en-AU",
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "legal-instrument-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title",
            "Created-At"
          ]
        }
      },
      {
        "id": "wte-memorandum-source-v1",
        "severity": "info",
        "selectors": {
          "doc_types": [
            "MEM",
            "LOW",
            "ANN",
            "SCH",
            "FRM",
            "NTC"
          ],
          "extensions": [
            "md"
          ],
          "paths_glob": [
            "**/*_MEM-*.md",
            "**/*_LOW-*.md",
            "**/*_ANN-*.md",
            "**/*_SCH-*.md",
            "**/*_FRM-*.md",
            "**/*_NTC-*.md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls"
            ]
          },
          "language_locale": "en-AU",
          "formatting_profile": "canonical-ascii",
          "markdown_style_profile_id": "legal-instrument-v1",
          "markdown_envelope_id": "record-markdown-envelope-v1",
          "markdown_hash_surface": "markdown-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "Document-Type",
            "Record-ID",
            "Title"
          ],
          "metadata_optional_fields": [
            "Effective-Date",
            "Version",
            "Status",
            "Confidentiality",
            "Governing-Law"
          ]
        }
      }
    ]
  }
}
