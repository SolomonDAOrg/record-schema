{
  "schema": "record-schema-formatting-pack",
  "schema_version": 1,
  "pack_id": "entity-constitutional-v1",
  "description": "Formatting pack for non-DAO entity constitutive and supporting records. Imports base-v1 and provides metadata, style, and ruleset enforcement for constitutions, bylaws, articles, charters, company agreements, memoranda, resolutions, indexes, registers, annexes, and schedules.",
  "imports": [
    "formatting/packs/base-v1.json"
  ],
  "document_policies": {
    "style_profiles": {
      "entity-constitutional-v1": {
        "description": "Formal constitutive instruments for non-DAO entities. Dense, structured, neutral, and clause-oriented.",
        "heading_numbering": "required",
        "subsection_numbering": "required",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for short labels, defined terms, and limited emphasis."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "entity-memorandum-v1": {
        "description": "Explanatory memoranda accompanying constitutive records. Clear, formal, and less dense than constitutions or charters.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for short labels, section cues, and limited emphasis."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "entity-index-v1": {
        "description": "Indexes, document registers, and navigational records for entity constitutional packets.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for labels and section cues."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      },
      "entity-annex-v1": {
        "description": "Schedules, annexes, forms, and register-style attachments to constitutive records.",
        "heading_numbering": "optional",
        "subsection_numbering": "optional",
        "clause_style": "atx_heading",
        "list_markers": {
          "top_level": "hyphen",
          "sub_item_nesting": [
            {
              "level": 1,
              "style": "hyphen"
            },
            {
              "level": 2,
              "style": "hyphen"
            }
          ],
          "sub_item_placement": "block",
          "indent_spaces_per_level": 2
        },
        "section_dividers": {
          "between_major_sections": "none",
          "between_subsections": "none"
        },
        "bold_policy": {
          "use": "sparingly",
          "note": "Bold reserved for labels, form prompts, and short emphasis."
        },
        "emphasis_policy": "allow",
        "inline_formatting": "preserve"
      }
    },
    "rulesets": [
      {
        "id": "root-license-v1",
        "severity": "error",
        "selectors": {
          "paths_glob": [
            "LICENSE"
          ],
          "is_root_file": true
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64",
              "legal_citations"
            ]
          },
          "language_locale": "en-US",
          "dialect_pack": "en-US-basic-v1",
          "formatting_profile": "canonical-ascii",
          "header_shape_id": "license-header-v1",
          "footer_shape_id": "license-footer-v1",
          "body_shape_id": "license-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
              "SPDX-LicenseIdentifier",
              "Document-Type",
              "Title",
              "Version",
              "Effective-Date",
              "Canonical-URL",
              "Checksum-SHA256",
              "Checksum-Surface"
          ],
          "style_profile_id": "license-v1",
          "header_template_path": "formatting/templates/root/LICENSE-header-v1.txt",
          "footer_template_path": "formatting/templates/root/LICENSE-footer-v1.txt"
        }
      },
      {
        "id": "license-documents-v1",
        "severity": "error",
        "selectors": {
          "doc_types": [
            "LIC"
          ],
          "paths_glob": [
            "**/LICENSE",
            "**/LICENSE-*.md",
            "**/*_LIC-*.md"
          ]
        },
        "enforce": {
          "line_width": {
            "max": 80,
            "ignore_blocks": [
              "code",
              "tables",
              "urls",
              "base58",
              "base64",
              "legal_citations"
            ]
          },
          "formatting_profile": "canonical-ascii",
          "header_shape_id": "license-header-v1",
          "footer_shape_id": "license-footer-v1",
          "body_shape_id": "license-body-v1",
          "metadata_shape_id": "document-metadata-block-v1",
          "style_profile_id": "license-v1",
          "require_metadata_block": true,
          "metadata_required_fields": [
            "SPDX-LicenseIdentifier",
            "Document-Type",
            "Title",
            "Version",
            "Effective-Date",
            "Canonical-URL",
            "Checksum-SHA256",
            "Checksum-Surface"
