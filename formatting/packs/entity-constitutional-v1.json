    "templates": {
      "entity-constitution-metadata-block-v1": {
        "description": "Template for constitutions, bylaws, articles, charters, and agreements.",
        "content": [
          "",
          "----------------------------BEGIN DOCUMENT METADATA-----------------------------",
          "Document-Type: ${document_type}",
          "Record-ID: ${record_id}",
          "Title: ${title}",
          "Version: ${version}",
          "Status: ${status}",
          "Effective-Date: ${effective_date}",
          "Confidentiality: ${confidentiality}",
          "-----------------------------END DOCUMENT METADATA------------------------------"
        ]
      },
      "entity-memorandum-metadata-block-v1": {
        "description": "Template for explanatory memoranda.",
        "content": [
          "",
          "----------------------------BEGIN DOCUMENT METADATA-----------------------------",
          "Document-Type: MEMORANDUM",
          "Record-ID: ${record_id}",
          "Title: ${title}",
          "Version: ${version}",
